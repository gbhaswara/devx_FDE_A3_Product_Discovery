# Copy to .env and fill in locally. .env is git-ignored; this file is not.
# `./run.sh` loads .env for serve/ask/eval. The test commands ignore it, so
# `./run.sh test-offline` stays free of both a model and an embedding server.

# Criteria extraction — any OpenAI-compatible endpoint.
# A local server needs no key; the header is sent only when one is set.
PAPERLANE_LLM_BASE_URL=http://127.0.0.1:20128/v1
PAPERLANE_LLM_MODEL=9inference
PAPERLANE_LLM_API_KEY=

# Reasoning models only: "none" turns thinking off. Leave unset for providers
# that reject the parameter.
# PAPERLANE_LLM_REASONING_EFFORT=none

# Embeddings — local Ollama, bge-m3 (1024 dimensions). Optional: with no
# provider the similarity term is omitted from the ranking, not zeroed.
PAPERLANE_EMBED_BASE_URL=http://localhost:11434
PAPERLANE_EMBED_MODEL=bge-m3:latest
